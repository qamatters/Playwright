<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="AutomationPlaygroundDemoWebForm" verbose="5">
    <listeners>
        <listener class-name="listeners.ExtentTestNGReporter" />
    </listeners>
    <test name="AIPOC">
        <parameter name="browser" value="chrome"/>
        <parameter name="headless" value="false"/>
        <parameter name="logMode" value="console"/>
        <parameter name="url" value="https://qamatters.github.io/demoautomationWebSite/index.html"/>
        <parameter name="videoRecording" value="false"/>
        <parameter name="enableScreenShotOnSuccess" value="false"></parameter>
        <classes>
            <class name="tests.UI.tests.playground.AIPOC.AISolution_testTimeoutException"></class>
            <class name="tests.UI.tests.playground.AIPOC.AISolution_testLoginFailure"></class>
            <class name="tests.UI.tests.playground.AIPOC.AISolution_testNullPointerException"></class>
            <class name="tests.UI.tests.playground.AIPOC.AISolution_ArrayIndexOutOfBondException"></class>
        </classes>
    </test> <!-- Test -->
</suite> <!-- Suite -->
